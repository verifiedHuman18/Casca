{
  "name": "@senoom/backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prebuild": "npm run build --workspace=@senoom/shared",
    "pretypecheck": "npm run build --workspace=@senoom/shared",
    "pretest": "npm run build --workspace=@senoom/shared",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:migrate:events": "tsx scripts/migrate.ts",
    "db:smoke": "tsx scripts/smoke-test-events.ts"
  },
  "dependencies": {
    "@senoom/shared": "*",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
