{
  "name": "senoom-campus-platform",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Casca - Campus Management Platform - OOPS & SE Project",
  "workspaces": [
    "backend",
    "client",
    "shared"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "npm run build --workspace=@senoom/shared && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.18.0",
    "@types/react": "^19.3.0",
    "eslint": "^9.18.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "bcrypt@6.0.0": true
  },
  "overrides": {
    "@types/react": "^19.3.0",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.5"
    }
  }
}
